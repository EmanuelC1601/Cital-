# Copia este archivo a .env y define una contraseña local propia antes de iniciar SQL Server.
MSSQL_SA_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_LOCAL_LARGA
# Configuración opcional del proveedor SMTP fuera de desarrollo; reemplaza localmente y no publiques valores reales.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
APPLICATION_PUBLIC_BASE_URL=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development
