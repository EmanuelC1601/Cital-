@model Belleza.Web.Models.OwnerAgendaPage
@{ ViewData["Title"] = "Agenda"; var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId); string Local(DateTimeOffset instant) => TimeZoneInfo.ConvertTime(instant, zone).ToString("HH:mm"); string Status(Belleza.Domain.AppointmentStatus status) => status switch { Belleza.Domain.AppointmentStatus.Confirmed => "Confirmada", Belleza.Domain.AppointmentStatus.Cancelled => "Cancelada", Belleza.Domain.AppointmentStatus.Completed => "Atendida", _ => "Inasistencia" }; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 my-4"><div><p class="eyebrow mb-1">@Model.BusinessName</p><h1 class="display-6 fw-bold">Agenda</h1><p class="text-secondary">Zona horaria: @Model.TimeZoneId</p></div><a class="btn btn-outline-secondary" href="/negocio">Volver</a></div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["ManageLink"] is string link) { <div class="alert alert-info">Enlace privado para compartir manualmente: <a href="@link">Abrir enlace de gestión</a> <button class="btn btn-sm btn-outline-primary ms-2" id="copyManageLink" type="button" data-link="@link">Copiar enlace</button><span id="manageLinkStatus" class="small ms-2" role="status"></span></div> }
<form method="get" class="feature-card d-flex gap-2 align-items-end mb-3"><div><label class="form-label" for="date">Día</label><input class="form-control" id="date" name="date" type="date" value="@Model.Date" /></div><button class="btn btn-outline-primary">Ver agenda</button></form>
<details class="feature-card mb-3"><summary class="h5">Agregar cita manual</summary><form asp-action="Manual" method="post" class="row g-2 mt-2"><input type="hidden" name="Date" value="@Model.Date" /><div class="col-12 col-md-6"><label class="form-label">Servicio</label><select class="form-select" name="ServiceId" required>@foreach(var service in Model.Services.Where(x => x.IsActive)){<option value="@service.Id">@service.Name · $@service.Price.ToString("N2")</option>}</select></div><div class="col-6 col-md-3"><label class="form-label">Hora</label><input class="form-control" type="time" name="Time" required /></div><div class="col-12 col-md-6"><label class="form-label">Nombre</label><input class="form-control" name="CustomerName" maxlength="120" required /></div><div class="col-12 col-md-6"><label class="form-label">Teléfono</label><input class="form-control" name="CustomerPhone" maxlength="40" required /></div><div class="col-12"><button class="btn btn-primary">Agregar cita</button></div></form><p class="small text-secondary mb-0 mt-2">El horario se valida al guardar; las citas manuales usan el mismo bloqueo transaccional que las reservas públicas.</p></details>
<section class="d-grid gap-2">@foreach(var item in Model.Appointments){<article class="feature-card"><div class="d-flex flex-wrap justify-content-between gap-2"><div><p class="eyebrow mb-1">@Local(item.StartUtc)–@Local(item.StartUtc.AddMinutes(item.DurationMinutesSnapshot)) · @Status(item.Status)</p><h2 class="h5 mb-1">@item.CustomerName</h2><p class="mb-1">@item.ServiceNameSnapshot · $@item.PriceSnapshot.ToString("N2") MXN · @item.DurationMinutesSnapshot min</p><p class="small text-secondary mb-0">@item.CustomerPhone @if(!string.IsNullOrWhiteSpace(item.CustomerEmail)){<span>· @item.CustomerEmail</span>}</p></div>@if(item.Status == Belleza.Domain.AppointmentStatus.Confirmed){<div class="d-flex flex-wrap gap-2 align-items-start"><form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date"/><input type="hidden" name="action" value="cancelar"/><button class="btn btn-sm btn-outline-danger">Cancelar</button></form><form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date"/><input type="hidden" name="action" value="atendida"/><button class="btn btn-sm btn-outline-success">Atendida</button></form><form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date"/><input type="hidden" name="action" value="inasistencia"/><button class="btn btn-sm btn-outline-secondary">Inasistencia</button></form></div>}</div>@if(item.Status == Belleza.Domain.AppointmentStatus.Confirmed){<details class="mt-2"><summary>Reprogramar</summary><form asp-action="OwnerReschedule" asp-route-id="@item.Id" method="post" class="row g-2 mt-1"><div class="col-6"><label class="form-label">Nueva fecha</label><input class="form-control" type="date" name="date" required/></div><div class="col-6"><label class="form-label">Nueva hora</label><input class="form-control" type="time" name="time" required/></div><div class="col-12"><button class="btn btn-sm btn-outline-primary">Guardar cambio</button></div></form></details>}</article>}@if(Model.Appointments.Count==0){<div class="feature-card text-center text-secondary">No hay citas para esta fecha.</div>}</section>
@if(TempData["ManageLink"] is string copiedLink){<script>document.getElementById('copyManageLink')?.addEventListener('click', async event => { const link = new URL(event.currentTarget.dataset.link, window.location.origin).href; const status = document.getElementById('manageLinkStatus'); try { await navigator.clipboard.writeText(link); status.textContent = 'Enlace copiado'; } catch { status.textContent = link; } });</script>}
