@model Belleza.Application.Businesses.BusinessSummary
@{ ViewData["Title"] = "Mi negocio"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 my-4">
    <div><p class="eyebrow mb-2">Tu espacio de trabajo</p><h1 class="display-6 fw-bold mb-0">@Model.Name</h1></div>
    <span class="badge rounded-pill text-bg-success-subtle px-3 py-2">Prueba gratuita</span>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="feature-card h-100"><h2 class="h5">Tu agenda está lista para configurarse</h2><p class="text-secondary">En las siguientes entregas podrás agregar servicios, establecer horarios y compartir tu página de reservas.</p><div class="alert alert-light border mb-0">Tu prueba está disponible hasta <strong>@Model.TrialEndsAtUtc.ToLocalTime().ToString("d 'de' MMMM 'de' yyyy")</strong>.</div></div></div>
    <div class="col-lg-4"><div class="feature-card h-100"><p class="eyebrow">Tu enlace público</p><p class="h5 mb-2">/b/@Model.Slug</p><p class="small text-secondary">La página pública estará disponible al completar la configuración de tu negocio.</p></div></div>
</div>
