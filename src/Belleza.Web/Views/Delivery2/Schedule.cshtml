@model Belleza.Web.Models.SchedulePage
@{ ViewData["Title"] = "Horarios"; string DayName(DayOfWeek day) => day switch { DayOfWeek.Monday => "Lunes", DayOfWeek.Tuesday => "Martes", DayOfWeek.Wednesday => "Miércoles", DayOfWeek.Thursday => "Jueves", DayOfWeek.Friday => "Viernes", DayOfWeek.Saturday => "Sábado", _ => "Domingo" }; }
<div class="my-4"><p class="eyebrow mb-1">@Model.BusinessName</p><h1 class="display-6 fw-bold">Horarios y bloqueos</h1><p class="text-secondary">Estos datos configuran el calendario futuro. Aún no hay reservas ni horarios disponibles para reservar.</p></div>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-3">
<div class="col-lg-6"><section class="feature-card h-100"><h2 class="h5">Horario semanal</h2><form asp-action="AddWindow" method="post" class="row g-2 mb-3"><div class="col-5"><label class="form-label">Día</label><select class="form-select" name="Day">@foreach(DayOfWeek day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@DayName(day)</option> }</select></div><div class="col-3"><label class="form-label">Abre</label><input class="form-control" type="time" name="Start" required /></div><div class="col-3"><label class="form-label">Cierra</label><input class="form-control" type="time" name="End" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Agregar horario</button></div></form>
@foreach(var item in Model.Windows) { <div class="list-row"><span>@DayName(item.Day) · @item.Start.ToString("HH:mm")–@item.End.ToString("HH:mm")</span><form asp-action="DeleteScheduleItem" asp-route-kind="horario" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Eliminar horario">Eliminar</button></form></div> }</section></div>
<div class="col-lg-6"><section class="feature-card h-100"><h2 class="h5">Descansos</h2><form asp-action="AddBreak" method="post" class="row g-2 mb-3"><div class="col-5"><label class="form-label">Día</label><select class="form-select" name="Day">@foreach(DayOfWeek day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@DayName(day)</option> }</select></div><div class="col-3"><label class="form-label">Desde</label><input class="form-control" type="time" name="Start" required /></div><div class="col-3"><label class="form-label">Hasta</label><input class="form-control" type="time" name="End" required /></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">Agregar descanso</button></div></form>
@foreach(var item in Model.Breaks) { <div class="list-row"><span>@DayName(item.Day) · @item.Start.ToString("HH:mm")–@item.End.ToString("HH:mm")</span><form asp-action="DeleteScheduleItem" asp-route-kind="descanso" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div> }</section></div>
<div class="col-lg-6"><section class="feature-card h-100"><h2 class="h5">Fechas especiales</h2><form asp-action="SaveSpecialDate" method="post" class="row g-2 mb-3"><div class="col-5"><label class="form-label">Fecha</label><input class="form-control" type="date" name="Date" required /></div><div class="col-7 form-check align-self-end pb-2"><input class="form-check-input" id="isClosed" type="checkbox" name="IsClosed" value="true" checked /><input type="hidden" name="IsClosed" value="false"/><label class="form-check-label" for="isClosed">Cerrado todo el día</label></div><div class="col-6"><label class="form-label">Abre (si trabaja)</label><input class="form-control" type="time" name="Start" /></div><div class="col-6"><label class="form-label">Cierra</label><input class="form-control" type="time" name="End" /></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">Guardar fecha</button></div></form>
@foreach(var item in Model.Exceptions) { <div class="list-row"><span>@item.Date.ToString("dd/MM/yyyy") · @(item.IsClosed ? "Cerrado" : $"{item.Start:HH:mm}–{item.End:HH:mm}")</span><form asp-action="DeleteScheduleItem" asp-route-kind="fecha" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div> }</section></div>
<div class="col-lg-6"><section class="feature-card h-100"><h2 class="h5">Periodos bloqueados</h2><form asp-action="AddBlockedPeriod" method="post" class="row g-2 mb-3"><div class="col-12"><label class="form-label">Fecha</label><input class="form-control" type="date" name="Date" required /></div><div class="col-6"><label class="form-label">Desde</label><input class="form-control" type="time" name="Start" required /></div><div class="col-6"><label class="form-label">Hasta</label><input class="form-control" type="time" name="End" required /></div><div class="col-12"><label class="form-label">Motivo privado (opcional)</label><input class="form-control" name="Reason" maxlength="200" /></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">Bloquear periodo</button></div></form>
@foreach(var item in Model.BlockedPeriods) { <div class="list-row"><span>@item.Date.ToString("dd/MM/yyyy") · @item.Start.ToString("HH:mm")–@item.End.ToString("HH:mm")</span><form asp-action="DeleteScheduleItem" asp-route-kind="bloqueo" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div> }</section></div>
</div>
