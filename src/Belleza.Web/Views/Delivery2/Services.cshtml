@model Belleza.Web.Models.ServiceListPage
@{ ViewData["Title"] = "Servicios"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4"><div><p class="eyebrow mb-1">@Model.BusinessName</p><h1 class="display-6 fw-bold mb-0">Servicios</h1></div><a class="btn btn-outline-secondary" asp-controller="Business" asp-action="Index">Volver al negocio</a></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> }
<div asp-validation-summary="All" class="text-danger"></div>
<details class="feature-card mb-4" open>
    <summary class="h5">Agregar un servicio</summary>
    <form asp-action="SaveService" method="post" class="row g-3 mt-2">
        <div class="col-md-6"><label class="form-label" for="Name">Nombre</label><input class="form-control" id="Name" name="Name" maxlength="100" required /></div>
        <div class="col-md-3"><label class="form-label" for="Price">Precio (MXN)</label><input class="form-control" id="Price" name="Price" type="number" min="0" max="999999.99" step="0.01" required /></div>
        <div class="col-md-3"><label class="form-label" for="DurationMinutes">Duración (minutos)</label><input class="form-control" id="DurationMinutes" name="DurationMinutes" type="number" min="5" max="480" value="60" required /></div>
        <div class="col-md-6"><label class="form-label" for="Description">Descripción</label><textarea class="form-control" id="Description" name="Description" maxlength="500" rows="2"></textarea></div>
        <div class="col-md-3"><label class="form-label" for="BufferMinutes">Tiempo adicional (minutos)</label><input class="form-control" id="BufferMinutes" name="BufferMinutes" type="number" min="0" max="180" value="0" required /></div>
        <div class="col-12"><button class="btn btn-primary" type="submit">Guardar servicio</button></div>
    </form>
</details>
<div class="d-grid gap-3">
@foreach (var service in Model.Services)
{
    <article class="feature-card">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><div class="d-flex align-items-center gap-2"><h2 class="h5 mb-0">@service.Name</h2><span class="badge @(service.IsActive ? "text-bg-success" : "text-bg-secondary")">@(service.IsActive ? "Activo" : "Inactivo")</span></div><p class="text-secondary mt-2 mb-1">$@service.Price.ToString("N2") MXN · @service.DurationMinutes min · @service.BufferMinutes min adicionales</p><p class="mb-0">@service.Description</p></div><div class="d-flex flex-wrap gap-2"><form asp-action="ToggleService" asp-route-id="@service.Id" method="post"><button class="btn btn-sm btn-outline-primary" type="submit">@(service.IsActive ? "Desactivar" : "Activar")</button></form><form asp-action="DeleteService" asp-route-id="@service.Id" method="post" onsubmit="return confirm('¿Eliminar este servicio?')"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></div></div>
        <details class="mt-3"><summary>Editar servicio</summary><form asp-action="SaveService" method="post" class="row g-3 mt-1">
            <input type="hidden" name="Id" value="@service.Id" />
            <div class="col-md-6"><label class="form-label">Nombre</label><input class="form-control" name="Name" value="@service.Name" maxlength="100" required /></div>
            <div class="col-md-3"><label class="form-label">Precio (MXN)</label><input class="form-control" name="Price" value="@service.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="999999.99" step="0.01" required /></div>
            <div class="col-md-3"><label class="form-label">Duración (minutos)</label><input class="form-control" name="DurationMinutes" value="@service.DurationMinutes" type="number" min="5" max="480" required /></div>
            <div class="col-md-6"><label class="form-label">Descripción</label><textarea class="form-control" name="Description" maxlength="500" rows="2">@service.Description</textarea></div>
            <div class="col-md-3"><label class="form-label">Tiempo adicional (minutos)</label><input class="form-control" name="BufferMinutes" value="@service.BufferMinutes" type="number" min="0" max="180" required /></div>
            <div class="col-md-3 form-check align-self-center ms-2"><input class="form-check-input" name="IsActive" type="checkbox" value="true" checked="@service.IsActive" /><input name="IsActive" type="hidden" value="false" /><label class="form-check-label">Activo en la página pública</label></div>
            <div class="col-12"><button class="btn btn-primary" type="submit">Guardar cambios</button></div>
        </form></details>
    </article>
}
</div>
@if (Model.Services.Count == 0) { <div class="feature-card text-center text-secondary">Aún no agregas servicios.</div> }
