<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Citalu.Application\Citalu.Application.csproj" />
    <ProjectReference Include="..\Citalu.Infrastructure\Citalu.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Never package local keys, captured mail, or synthetic uploads from an ignored developer data directory. -->
  <ItemGroup>
    <Content Remove="data\**\*;wwwroot\uploads\**\*" />
    <None Remove="data\**\*;wwwroot\uploads\**\*" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Fija el paquete transitivo a la versión corregida del aviso CVE-2026-84008. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>65f16728-7949-4f23-8439-848df9feb409</UserSecretsId>
    <EnvironmentName>Demo</EnvironmentName>
  </PropertyGroup>

</Project>
