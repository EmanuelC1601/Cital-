@model Citalu.Web.Models.ResetPasswordInput
@{ ViewData["Title"] = "Nueva contraseña · Citalú"; }
<div class="form-shell"><h1 class="h2 fw-bold">Elige una contraseña nueva</h1><form method="post" class="mt-4">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="UserId" type="hidden"/><input asp-for="Code" type="hidden"/>
<label asp-for="Password" class="form-label">Nueva contraseña</label><input asp-for="Password" class="form-control" autocomplete="new-password" required/>
<label asp-for="ConfirmPassword" class="form-label mt-3">Confirma la contraseña</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required/>
<button class="btn btn-primary btn-lg w-100 mt-4" type="submit">Actualizar contraseña</button></form></div>
