@model Citalu.Web.Models.EmailInput
@{ ViewData["Title"] = "Recuperar acceso · Citalú"; }
<div class="form-shell"><h1 class="h2 fw-bold">Recuperar acceso</h1>
@if (TempData["AccountMessage"] is string message) { <div class="alert alert-info" role="status">@message</div> }
<form method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<label asp-for="Email" class="form-label">Correo electrónico</label><input asp-for="Email" class="form-control form-control-lg" autocomplete="email" required />
<button class="btn btn-primary btn-lg w-100 mt-3" type="submit">Enviar instrucciones</button></form></div>
