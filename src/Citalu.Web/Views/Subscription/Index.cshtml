@model Citalu.Web.Models.SubscriptionOwnerPage
@{ ViewData["Title"] = "Suscripción · Citalú"; }
<div class="my-4"><p class="eyebrow">Citalú · @Model.BusinessName</p><h1 class="display-6 fw-bold">Prueba y suscripción</h1></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
<div class="row g-3"><div class="col-lg-7"><section class="feature-card h-100"><span class="badge text-bg-light border">@Model.State.Label</span><h2 class="h4 mt-3">@Model.State.PlanName · @Model.State.MonthlyPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-MX")) @Model.State.Currency / mes</h2><p>Acceso hasta <strong>@Model.State.AccessUntilUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</strong>. El mes se cuenta como mes calendario desde la fecha de inicio; el fin es exclusivo.</p><p class="small text-secondary">@Model.State.TaxDisplay. No se realizan cobros automáticos. El precio y la información fiscal final dependen de la configuración de la plataforma.</p>
@if (Model.State.InGrace) { <div class="alert alert-warning">Tu negocio está en periodo de gracia. Las nuevas reservas están habilitadas temporalmente.</div> }
@if (Model.Subscription.RenewalCancelled) { <div class="alert alert-info">La renovación futura está cancelada. Conservas el periodo ya concedido.</div><form asp-action="ResumeRenewal" method="post"><button class="btn btn-outline-primary">Volver a habilitar renovación</button></form> }
else { <form asp-action="CancelRenewal" method="post"><button class="btn btn-outline-secondary">Cancelar renovación futura</button></form> }
</section></div><div class="col-lg-5"><section class="feature-card h-100"><h2 class="h5">Cómo continuar</h2>@if (string.IsNullOrWhiteSpace(Model.PaymentInstructions)) { <p>Las instrucciones de pago todavía no están configuradas. Contacta al soporte de Citalú.</p> } else { <p class="text-break">@Model.PaymentInstructions</p> }<div class="alert alert-light border mb-0">Reportar o solicitar un pago no activa la suscripción. Solo un administrador de plataforma puede registrar el pago y conceder cobertura.</div></section></div></div>
<section class="feature-card mt-3"><h2 class="h5">Periodos de cobertura</h2>@if(Model.Periods.Count == 0){<p class="text-secondary">Aún no hay periodos pagados.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Desde UTC</th><th>Hasta UTC</th><th>Importe</th><th>Estado</th><th>Responsable</th></tr></thead><tbody>@foreach(var p in Model.Periods){<tr><td>@p.StartsAtUtc.ToString("g")</td><td>@p.EndsAtUtc.ToString("g")</td><td>@p.Amount.ToString("N2") @p.Currency</td><td>@p.Status</td><td>Equipo Citalú</td></tr>}</tbody></table></div>}</section>
<section class="feature-card mt-3"><h2 class="h5">Historial de pagos</h2>@if(Model.Payments.Count == 0){<p class="text-secondary">No hay pagos registrados.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Registrado</th><th>Fecha de pago</th><th>Importe</th><th>Referencia</th><th>Responsable</th><th>Tipo</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.RecordedAtUtc.ToString("g") UTC</td><td>@p.PaidAtUtc.ToString("g") UTC</td><td>@p.Amount.ToString("N2") @p.Currency</td><td>@p.Reference</td><td>Equipo Citalú</td><td>@(p.ReversesPaymentId.HasValue ? "Corrección" : "Pago manual")</td></tr>}</tbody></table></div>}</section>
