<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Citalú</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Citalú</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Business" asp-action="Index">Mi negocio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Delivery2" asp-action="Services">Servicios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Delivery2" asp-action="Schedule">Horarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Delivery2" asp-action="Profile">Página pública</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Agenda">Agenda</a></li>
                            <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-link nav-link" type="submit">Cerrar sesión</button></form></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item ms-sm-2"><a class="btn btn-primary" asp-controller="Account" asp-action="Register">Crear cuenta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["AccountMessage"] is string accountMessage) { <div class="alert alert-info mt-3" role="status">@accountMessage @if (TempData["NeedsConfirmation"] is true) { <a asp-controller="Account" asp-action="ResendConfirmation">Reenviar confirmación</a> }</div> }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Citalú · <a asp-controller="Home" asp-action="Privacy">Privacidad (provisional)</a> · <a asp-controller="Home" asp-action="Terms">Términos (provisionales)</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
