@model Citalu.Web.Models.PlatformSubscriptionAdminPage
@{ ViewData["Title"] = "Administración de suscripciones · Citalú"; }
<div class="my-4"><p class="eyebrow">Administración de plataforma</p><h1 class="display-6 fw-bold">Suscripciones y pagos manuales</h1><p>@Model.PlanName · @Model.MonthlyPrice.ToString("N2") @Model.Currency al mes · @Model.TaxDisplay</p></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="d-grid gap-3">@foreach(var row in Model.Businesses){<article class="feature-card"><div class="d-flex flex-wrap justify-content-between gap-2"><div><h2 class="h5">@row.BusinessName</h2><p class="text-secondary mb-1">@row.OwnerEmail · /b/@row.Slug</p><span class="badge text-bg-light border">@row.State.Label</span><p class="small mt-2 mb-0">Acceso hasta @row.State.AccessUntilUtc.ToString("g") UTC · Cancelación de renovación: @(row.Subscription.RenewalCancelled ? "sí" : "no")</p></div></div>
<form asp-action="RecordPayment" method="post" class="row g-2 mt-2 payment-form"><input type="hidden" name="BusinessId" value="@row.BusinessId"/><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><div class="col-6 col-md-2"><label class="form-label">Importe</label><input class="form-control" type="number" min="0.01" max="99999999.99" step="0.01" name="Amount" value="@Model.MonthlyPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></div><div class="col-6 col-md-2"><label class="form-label">Moneda</label><input class="form-control" name="Currency" value="@Model.Currency" maxlength="3" required/></div><div class="col-12 col-md-3"><label class="form-label">Referencia</label><input class="form-control" name="Reference" maxlength="120" required/></div><div class="col-12 col-md-3"><label class="form-label">Fecha y hora del pago (tu hora local)</label><input class="form-control" type="datetime-local" data-paid-at-local required/><input type="hidden" name="PaidAtUtc" data-paid-at-utc value="@DateTimeOffset.UtcNow.ToString("O")"/></div><div class="col-12 col-md-2 d-flex align-items-end"><button class="btn btn-primary">Registrar y conceder un mes</button></div></form>
<p class="small text-secondary mt-2">Pago anticipado: comienza al terminar la prueba o cobertura actual. Pago posterior al vencimiento: comienza al registrarlo; el tiempo vencido no se repone. Periodo [inicio, fin), un mes calendario UTC.</p>
@if(row.Payments.Count>0){<details class="mt-2"><summary>Pagos y correcciones</summary>@foreach(var payment in row.Payments){<div class="border rounded p-2 mt-2"><span>@payment.RecordedAtUtc.ToString("g") UTC · @payment.Amount.ToString("N2") @payment.Currency · @payment.Reference · @payment.RecordedByUserId</span>@if(payment.ReversesPaymentId is null){<form asp-action="CorrectPayment" method="post" class="d-flex flex-wrap gap-2 mt-2"><input type="hidden" name="PaymentId" value="@payment.Id"/><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><input class="form-control" name="Reason" maxlength="500" minlength="5" placeholder="Motivo de corrección" required/><button class="btn btn-sm btn-outline-danger">Revertir y revocar periodo</button></form>}</div>}</details>}
</article>}</div>
<script>document.querySelectorAll('.payment-form').forEach(form => { const local = form.querySelector('[data-paid-at-local]'); const utc = form.querySelector('[data-paid-at-utc]'); const now = new Date(); local.value = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16); form.addEventListener('submit', () => { utc.value = new Date(local.value).toISOString(); }); });</script>
