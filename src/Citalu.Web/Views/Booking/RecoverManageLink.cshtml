@model Citalu.Web.Models.RecoverManageLinkInput
@{ ViewData["Title"] = "Recuperar enlace · Citalú"; }
<section class="form-shell"><h1 class="h2 fw-bold">Recupera el enlace de tu cita</h1><p class="text-secondary">Solo enviaremos instrucciones al correo asociado a la reserva.</p>
<form asp-action="RecoverManageLink" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="RequestId" type="hidden" />
<div class="mb-3"><label asp-for="AppointmentId" class="form-label">Folio de cita</label><input asp-for="AppointmentId" class="form-control" autocomplete="off" required /></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Correo usado en la reserva</label><input asp-for="Email" class="form-control" autocomplete="email" required /></div>
<button class="btn btn-primary btn-lg w-100">Enviar enlace de recuperación</button></form></section>
