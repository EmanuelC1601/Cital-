@{ ViewData["Title"] = "Gestionar cita"; }
<section class="feature-card my-5 mx-auto" style="max-width:42rem" id="manage"><p class="eyebrow">Enlace privado</p><h1 class="h2">Gestiona tu cita</h1><p id="manageStatus" class="text-secondary" aria-live="polite">Validando enlace…</p><div id="manageDetails" class="d-none"><dl class="row" id="summary"></dl><div id="manageActions" class="d-flex flex-wrap gap-2"><button class="btn btn-outline-danger" id="cancelAppointment">Cancelar cita</button><button class="btn btn-primary" id="showReschedule">Reprogramar</button></div><div id="rescheduleBox" class="row g-2 mt-3 d-none"><div class="col-6"><label class="form-label" for="newDate">Fecha</label><input class="form-control" id="newDate" type="date" /></div><div class="col-6"><label class="form-label" for="newTime">Hora disponible</label><select class="form-select" id="newTime" disabled><option>Elige una fecha</option></select></div><div class="col-12"><button class="btn btn-primary" id="saveReschedule">Confirmar cambio</button></div></div><div id="manageMessage" class="alert d-none mt-3" role="status"></div></div></section>
@section Scripts { <script src="~/js/manage-booking.js" asp-append-version="true"></script> }
