@model Citalu.Web.Models.OwnerAgendaPage
@using System.Globalization
@{
    ViewData["Title"] = "Agenda";
    var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId);
    var day = Model.Date;
    var dateValue = day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).DateTime);
    var initial = string.IsNullOrWhiteSpace(Model.BusinessName) ? "N" : Model.BusinessName.Trim()[0].ToString().ToUpperInvariant();
    string Local(DateTimeOffset instant) => TimeZoneInfo.ConvertTime(instant, zone).ToString("HH:mm", CultureInfo.InvariantCulture);
    string Status(Citalu.Domain.AppointmentStatus status) => status switch
    {
        Citalu.Domain.AppointmentStatus.Confirmed => "Confirmada",
        Citalu.Domain.AppointmentStatus.Cancelled => "Cancelada",
        Citalu.Domain.AppointmentStatus.Completed => "Atendida",
        _ => "Inasistencia"
    };
    string StatusClass(Citalu.Domain.AppointmentStatus status) => status switch
    {
        Citalu.Domain.AppointmentStatus.Confirmed => "status-confirmed",
        Citalu.Domain.AppointmentStatus.Cancelled => "status-cancelled",
        Citalu.Domain.AppointmentStatus.Completed => "status-completed",
        _ => "status-missed"
    };
    var dateLabel = day.ToDateTime(TimeOnly.MinValue).ToString("dddd, d 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("es-MX"));
    var spanishDate = char.ToUpper(dateLabel[0], CultureInfo.GetCultureInfo("es-MX")) + dateLabel[1..];
}

<section class="agenda-page" aria-labelledby="agendaTitle">
    <header class="agenda-heading">
        <div class="agenda-title-group">
            <span class="business-avatar" aria-hidden="true">@initial</span>
            <div>
                <p class="eyebrow">@Model.BusinessName</p>
                <h1 id="agendaTitle">Agenda</h1>
                <div class="agenda-zone"><span>Hora local del negocio</span><details class="zone-details"><summary>Zona horaria</summary><span>@Model.TimeZoneId</span></details></div>
            </div>
        </div>
        <div class="agenda-heading-actions">
            <a class="btn btn-secondary-action" asp-action="ExportAgenda" aria-label="Exportar agenda como CSV">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 17v3h14v-3"/></svg><span>Exportar</span>
            </a>
            <a class="btn btn-primary" href="#new-appointment" data-open-appointment>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Nueva cita</span>
            </a>
        </div>
    </header>

    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
    @if (TempData["ManageLink"] is string link)
    {
        <div class="manage-link-notice" role="status">
            <div><strong>Enlace privado de gestión</strong><span>Guárdalo y compártelo solo con la persona de la cita.</span></div>
            <a class="btn btn-secondary-action" href="@link">Abrir enlace</a>
            <button class="btn btn-secondary-action" id="copyManageLink" type="button" data-link="@link">Copiar</button>
            <span id="manageLinkStatus" class="small" aria-live="polite"></span>
        </div>
    }

    @if (Model.NotificationStates.Values.Any())
    {
        <p class="agenda-global-mail-state"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg> Estado del envío de correo: @string.Join(" · ", Model.NotificationStates.Values.Distinct())</p>
    }
    @if (Model.FailedNotificationIds.Count > 0)
    {
        <section class="alert alert-warning" aria-label="Notificaciones con error">
            <p>Hay correos que requieren reintento:</p>
            @foreach (var item in Model.FailedNotificationIds)
            {
                <form asp-action="RetryNotification" asp-route-id="@item.Value" method="post" class="d-inline-block me-2"><input type="hidden" name="date" value="@Model.Date" /><button class="btn btn-sm btn-secondary-action" type="submit">Reintentar correo</button></form>
            }
        </section>
    }

    <section class="agenda-date-panel" aria-label="Fecha de la agenda">
        <div class="agenda-date-nav">
            <a class="icon-button date-step" asp-action="Agenda" asp-route-date="@day.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Día anterior" title="Día anterior">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <div class="agenda-date-copy"><p class="agenda-date-label">@spanishDate</p><span>@Model.Appointments.Count @(Model.Appointments.Count == 1 ? "cita" : "citas")</span></div>
            <a class="icon-button date-step" asp-action="Agenda" asp-route-date="@day.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Día siguiente" title="Día siguiente">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
        </div>
        <form class="agenda-date-tools" method="get" asp-action="Agenda" id="agendaDateForm">
            <label class="visually-hidden" for="agendaDate">Seleccionar fecha</label>
            <input class="form-control date-picker" id="agendaDate" name="date" type="date" value="@dateValue" aria-label="Seleccionar fecha de agenda" />
            @if (day != today) { <a class="btn btn-secondary-action today-button" asp-action="Agenda" asp-route-date="@today.ToString("yyyy-MM-dd")">Hoy</a> }
        </form>
    </section>

    <details class="new-appointment-panel" id="new-appointment">
        <summary class="new-appointment-summary">
            <span class="new-appointment-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>
            <span><strong>Agregar cita</strong><small>Se validará contra horarios, descansos y bloqueos del negocio.</small></span>
            <span class="summary-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg></span>
        </summary>
        <form asp-action="Manual" method="post" class="manual-appointment-form">
            <input type="hidden" name="Date" value="@dateValue" />
            <div class="form-field-group">
                <label class="form-label" for="manualService">Servicio</label>
                <select class="form-select" id="manualService" name="ServiceId" required>
                    <option value="">Selecciona un servicio</option>
                    @foreach (var service in Model.Services.Where(x => x.IsActive))
                    {
                        <option value="@service.Id" selected="@(Model.Input.ServiceId == service.Id)">@service.Name · $@service.Price.ToString("N2") MXN</option>
                    }
                </select>
            </div>
            <div class="form-field-group">
                <label class="form-label" for="manualTime">Hora local</label>
                <input class="form-control" id="manualTime" type="time" name="Time" value="@(Model.Input.Time == default ? "" : Model.Input.Time.ToString("HH:mm", CultureInfo.InvariantCulture))" required />
                <span class="form-hint">La cita debe caber completa en el horario disponible; el servidor confirma el espacio al guardar.</span>
            </div>
            <div class="form-field-group">
                <label class="form-label" for="manualName">Nombre del cliente</label>
                <input class="form-control" id="manualName" name="CustomerName" value="@Model.Input.CustomerName" maxlength="120" autocomplete="name" required />
            </div>
            <div class="form-field-group">
                <label class="form-label" for="manualPhone">Teléfono</label>
                <input class="form-control" id="manualPhone" name="CustomerPhone" value="@Model.Input.CustomerPhone" maxlength="40" autocomplete="tel" type="tel" required />
            </div>
            <div class="form-field-group">
                <label class="form-label" for="manualEmail">Correo <span class="optional-label">(opcional)</span></label>
                <input class="form-control" id="manualEmail" name="CustomerEmail" value="@Model.Input.CustomerEmail" maxlength="254" autocomplete="email" type="email" />
            </div>
            <div class="manual-form-actions"><span class="form-hint">La confirmación se registra al guardar.</span><button class="btn btn-primary" type="submit">Guardar cita</button></div>
        </form>
    </details>

    <section class="agenda-list" aria-label="Citas del día">
        @if (Model.Appointments.Count == 0)
        {
            <div class="agenda-empty-state">
                <span class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M7.5 3v4M16.5 3v4M3.5 10h17M8 14h.01M12 14h.01M16 14h.01"/></svg></span>
                <h2>No hay citas registradas para este día</h2>
                <p>Puedes agregar una cita o compartir la página de tu negocio.</p>
                <div class="empty-state-actions"><a class="btn btn-primary" href="#new-appointment" data-open-appointment>Agregar cita</a><a class="btn btn-secondary-action" href="/b/@Model.Slug">Compartir mi enlace</a></div>
            </div>
        }
        else
        {
            @foreach (var item in Model.Appointments)
            {
                var end = item.StartUtc.AddMinutes(item.DurationMinutesSnapshot);
                <article class="appointment-row">
                    <div class="appointment-time"><strong>@Local(item.StartUtc)</strong><span>@Local(end)</span></div>
                    <div class="appointment-content">
                        <div class="appointment-main-line">
                            <div><h2>@item.CustomerName</h2><p>@item.ServiceNameSnapshot <span aria-hidden="true">·</span> $@item.PriceSnapshot.ToString("N2") MXN <span aria-hidden="true">·</span> @item.DurationMinutesSnapshot min</p></div>
                            <span class="appointment-status @StatusClass(item.Status)"><span class="status-dot" aria-hidden="true"></span>@Status(item.Status)</span>
                        </div>
                        <p class="appointment-contact">@item.CustomerPhone @if (!string.IsNullOrWhiteSpace(item.CustomerEmail)) { <span>· @item.CustomerEmail</span> }</p>
                        @if (Model.NotificationStates.TryGetValue(item.Id, out var notificationState))
                        {
                            <p class="appointment-mail-state"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span>Correo: @notificationState</span></p>
                        }
                        @if (item.Status == Citalu.Domain.AppointmentStatus.Confirmed)
                        {
                            <div class="appointment-actions">
                                <details class="reschedule-details">
                                    <summary>Reprogramar</summary>
                                    <form asp-action="OwnerReschedule" asp-route-id="@item.Id" method="post" class="reschedule-form">
                                        <label class="form-label" for="rescheduleDate-@item.Id">Nueva fecha</label><input class="form-control" id="rescheduleDate-@item.Id" type="date" name="date" required />
                                        <label class="form-label" for="rescheduleTime-@item.Id">Nueva hora</label><input class="form-control" id="rescheduleTime-@item.Id" type="time" name="time" required />
                                        <button class="btn btn-sm btn-primary" type="submit">Guardar cambio</button>
                                    </form>
                                </details>
                                <form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date" /><input type="hidden" name="action" value="cancelar" /><button class="btn btn-sm btn-secondary-action" type="submit">Cancelar cita</button></form>
                                <form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date" /><input type="hidden" name="action" value="atendida" /><button class="btn btn-sm btn-secondary-action" type="submit">Atendida</button></form>
                                <form asp-action="SetStatus" asp-route-id="@item.Id" method="post"><input type="hidden" name="date" value="@Model.Date" /><input type="hidden" name="action" value="inasistencia" /><button class="btn btn-sm btn-secondary-action" type="submit">Inasistencia</button></form>
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </section>
</section>

@if (TempData["ManageLink"] is string copiedLink)
{
    <script>
        document.getElementById('copyManageLink')?.addEventListener('click', async event => {
            // The private token stays in the page response and is never written to application logs.
            const link = new URL(event.currentTarget.dataset.link, window.location.origin).href;
            const status = document.getElementById('manageLinkStatus');
            try { await navigator.clipboard.writeText(link); status.textContent = 'Enlace copiado'; }
            catch { status.textContent = 'No se pudo copiar. Abre el enlace y guárdalo de forma segura.'; }
        });
    </script>
}
