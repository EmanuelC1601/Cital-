@model Citalu.Web.Models.ProfilePage
@{ ViewData["Title"] = "Perfil público"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 my-4"><div><p class="eyebrow mb-1">@Model.BusinessName</p><h1 class="display-6 fw-bold mb-0">Perfil público</h1></div><a class="btn btn-outline-primary" href="/b/@Model.Slug" target="_blank" rel="noopener">Ver página pública</a></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div asp-validation-summary="All" class="text-danger"></div>
<section class="feature-card mb-4"><h2 class="h5">Datos públicos</h2><p class="small text-secondary">Solo se muestra lo que captures aquí. Tu correo de cuenta y otros datos privados no aparecen.</p>
<form asp-action="SaveProfile" method="post" class="row g-3">
    <div class="col-12"><label class="form-label" asp-for="Input.Description">Descripción</label><textarea class="form-control" asp-for="Input.Description" rows="3" maxlength="1000"></textarea></div>
    <div class="col-md-6"><label class="form-label" asp-for="Input.Location">Ubicación pública</label><input class="form-control" asp-for="Input.Location" maxlength="250" placeholder="Colonia, ciudad o dirección que quieras compartir" /></div>
    <div class="col-md-3"><label class="form-label" asp-for="Input.PublicPhone">Teléfono público</label><input class="form-control" asp-for="Input.PublicPhone" maxlength="40" /></div>
    <div class="col-md-3"><label class="form-label" asp-for="Input.PublicEmail">Correo público</label><input class="form-control" asp-for="Input.PublicEmail" maxlength="254" /></div>
    <div class="col-md-6"><label class="form-label" asp-for="Input.TimeZoneId">Zona horaria</label><input class="form-control" asp-for="Input.TimeZoneId" list="timeZoneOptions" placeholder="Busca por ciudad o zona" /><datalist id="timeZoneOptions">@foreach(var zone in Model.TimeZones) { <option value="@zone.Id">@zone.DisplayName</option> }</datalist></div>
    <div class="col-md-3"><label class="form-label" asp-for="Input.PrimaryColor">Color principal</label><input class="form-control form-control-color w-100" asp-for="Input.PrimaryColor" type="color" /></div>
    <div class="col-md-3"><label class="form-label" asp-for="Input.AccentColor">Color de fondo</label><input class="form-control form-control-color w-100" asp-for="Input.AccentColor" type="color" /></div>
    <div class="col-md-3"><label class="form-label" asp-for="Input.ReminderLeadHours">Recordatorio (horas antes)</label><input class="form-control" asp-for="Input.ReminderLeadHours" type="number" min="0" max="168" /><span class="form-text">0 desactiva los recordatorios.</span></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Guardar perfil</button></div>
</form></section>
<div class="row g-3">
    @foreach (var image in new[] { (Kind: "logo", Label: "Logo", Path: Model.LogoPath), (Kind: "portada", Label: "Portada", Path: Model.CoverPath) })
    {
        <div class="col-md-6"><section class="feature-card h-100"><h2 class="h5">@image.Label</h2>@if (!string.IsNullOrEmpty(image.Path)) { <img src="@image.Path" alt="@image.Label de @Model.BusinessName" class="img-fluid rounded mb-3" style="max-height:180px;object-fit:cover" /> }<form asp-action="UploadImage" asp-route-kind="@image.Kind" method="post" enctype="multipart/form-data"><label class="form-label" for="@image.Kind">Imagen JPG, PNG, WebP o GIF (máximo 3 MB)</label><input class="form-control mb-3" id="@image.Kind" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required /><button class="btn btn-outline-primary" type="submit">Cargar @image.Label.ToLowerInvariant()</button></form></section></div>
    }
</div>
